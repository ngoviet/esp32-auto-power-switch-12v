# ESPHome Secrets Template
# Copy file này thành 'secrets.yaml' và điền thông tin thực của bạn.
# Cả 5 khoá đều bắt buộc.

# WiFi
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Mật khẩu nạp firmware qua mạng (OTA)
ota_password: "your_ota_password"

# Mật khẩu Wi-Fi dự phòng (AP) khi ESP32 không vào được mạng, tối thiểu 8 ký tự
ap_password: "your_fallback_ap_password"

# Khoá mã hoá API với Home Assistant: 32 byte base64. Tạo bằng:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Home Assistant hỏi khoá này khi thêm thiết bị.
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY="
